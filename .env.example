# Copy this file to .env and set POSTGRES_PASSWORD before starting PostgreSQL.
# Use these settings only for local development; never commit real credentials.
# Values may be unquoted or single-quoted; keep each entry on one line.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=digital_wallet_reviews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Optional: DATABASE_URL overrides the POSTGRES_* settings for Python only.
# DATABASE_URL=
